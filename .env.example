# AVISO IMPORTANTE DE SEGURANÇA:
# Em produção (NODE_ENV=production), esta aplicação deve ser servida EXCLUSIVAMENTE atrás de HTTPS
# (via proxy reverso TLS como Traefik, Caddy ou Nginx), pois o cookie de sessão exige Secure.
# O proxy reverso deve sobrescrever o cabeçalho X-Forwarded-For (nunca apenas anexar).

LOG_LEVEL=info

# Credenciais e portas para o Docker Compose (apenas placeholders — defina valores reais no .env local).
# No Compose, DATABASE_URL dos containers é derivada de POSTGRES_*; DATABASE_URL e DATABASE_URL_TEST
# abaixo servem aos comandos executados diretamente no host — mantenha as credenciais em sincronia.
POSTGRES_USER=user
POSTGRES_PASSWORD=placeholder
POSTGRES_DB=kustertech_flow
POSTGRES_PORT=5440
WEB_PORT=3000

# Conexão no host (aponta para o Postgres exposto em POSTGRES_PORT)
DATABASE_URL=postgresql://user:placeholder@localhost:5440/kustertech_flow

# Banco separado para testes de integração no host (suba `docker compose up -d postgres`; o setup cria o banco de teste automaticamente)
DATABASE_URL_TEST=postgresql://user:placeholder@localhost:5440/kustertech_flow_test

# Senha não-interativa para `pnpm criar-admin` (apenas para CI/e2e; em operação manual use o prompt oculto do terminal; nunca defina valor real versionado)
# FLOW_ADMIN_SENHA=placeholder-apenas-ci-ou-e2e

# Porta do servidor Next.js durante os testes E2E com Playwright (padrão: 3131)
# E2E_PORT=3131

# Integração GitHub (lida só pelo worker; a web nunca recebe a chave da App).
# GITHUB_FONTE=fixtures usa dados fictícios e serve APENAS para desenvolvimento/teste; em operação deixe vazio ou use `app`.
# GITHUB_FONTE=fixtures
# GITHUB_APP_ID=placeholder
# GITHUB_APP_PRIVATE_KEY=placeholder-pem-com-\n-literais
# GITHUB_INTERVALO_MS=600000
# GITHUB_API_URL=https://api.github.com

# Webhooks do GitHub (opcional). Lida só pela web (nunca pelo worker); sem ela, POST /api/github/webhook responde 404.
# Use o mesmo valor no campo "Webhook secret" da GitHub App (roteiro: docs/github-app.md §9).
# GITHUB_WEBHOOK_SECRET=placeholder-gere-com-openssl-rand-hex-32

# Oficina (docker-compose.oficina.yml; ver docs/infra/oficina.md)
# FLOW_MAQUINA_LOCAL: o "identificador externo" da máquina no cadastro (a que roda o Flow).
# FLOW_MAQUINA_LOCAL=oficina
# OFICINA_DIR=/oficina
# FLOW_MODULOS_EXTRAS=
# FLOW_IMAGEM=ghcr.io/paulorhyank/kustertech-flow:main

# Arquivos das demandas (anexos, desenhos e capturas). Nos contêineres é /var/lib/flow/arquivos
# (volume flow_arquivos); no desenvolvimento, uma pasta local fora do Git.
FLOW_ARQUIVOS_DIR=./.dados/arquivos

# Erros do GlitchTip viram demandas (D81). O Flow só lê (GET, https). O token é criado na tela do
# GlitchTip e fica SÓ no .env da oficina; nunca no repositório. Sem estas variáveis a leitura não roda.
# GLITCHTIP_URL=https://erros.exemplo.com
# GLITCHTIP_ORG=minha-org
# GLITCHTIP_TOKEN=placeholder
# GLITCHTIP_PROJETOS=app-vendas:dono/app-vendas,portal:dono/portal
# Opcionais (padrões entre parênteses): ambientes de produção lidos (production,producao,produção,prod,live),
# eventos (10) ou horas ativo (2) para o erro virar demanda, e demandas automáticas por dia (3).
# GLITCHTIP_AMBIENTES=production,producao,live
# GLITCHTIP_LIMIAR_EVENTOS=10
# GLITCHTIP_LIMIAR_HORAS=2
# GLITCHTIP_DEMANDAS_POR_DIA=3
