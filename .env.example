# AVISO IMPORTANTE DE SEGURANÇA:
# Em produção (NODE_ENV=production), esta aplicação deve ser servida EXCLUSIVAMENTE atrás de HTTPS
# (via proxy reverso TLS como Traefik, Caddy ou Nginx), pois o cookie de sessão exige Secure.
# O proxy reverso deve sobrescrever o cabeçalho X-Forwarded-For (nunca apenas anexar).

NODE_ENV=development
LOG_LEVEL=info

# Credenciais e portas para o Docker Compose (apenas placeholders — defina valores reais no .env local)
POSTGRES_USER=user
POSTGRES_PASSWORD=placeholder
POSTGRES_DB=kustertech_flow
POSTGRES_PORT=5440
WEB_PORT=3000

# Conexão de desenvolvimento (aponta para o Postgres exposto em POSTGRES_PORT no host)
DATABASE_URL=postgresql://user:placeholder@localhost:5440/kustertech_flow

# Banco separado para testes de integração (suba `docker compose up -d postgres`; o setup cria o banco de teste automaticamente)
DATABASE_URL_TEST=postgresql://user:placeholder@localhost:5440/kustertech_flow_test
