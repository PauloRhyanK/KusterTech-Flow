# AVISO IMPORTANTE DE SEGURANÇA:
# Em produção (NODE_ENV=production), esta aplicação deve ser servida EXCLUSIVAMENTE atrás de HTTPS
# (via proxy reverso TLS como Traefik, Caddy ou Nginx), pois o cookie de sessão exige Secure.
# O proxy reverso deve sobrescrever o cabeçalho X-Forwarded-For (nunca apenas anexar).

LOG_LEVEL=info

# Credenciais e portas para o Docker Compose (apenas placeholders — defina valores reais no .env local).
# No Compose, DATABASE_URL dos containers é derivada de POSTGRES_*; DATABASE_URL e DATABASE_URL_TEST
# abaixo servem aos comandos executados diretamente no host — mantenha as credenciais em sincronia.
POSTGRES_USER=user
POSTGRES_PASSWORD=placeholder
POSTGRES_DB=kustertech_flow
POSTGRES_PORT=5440
WEB_PORT=3000

# Conexão no host (aponta para o Postgres exposto em POSTGRES_PORT)
DATABASE_URL=postgresql://user:placeholder@localhost:5440/kustertech_flow

# Banco separado para testes de integração no host (suba `docker compose up -d postgres`; o setup cria o banco de teste automaticamente)
DATABASE_URL_TEST=postgresql://user:placeholder@localhost:5440/kustertech_flow_test

# Senha não-interativa para `pnpm criar-admin` (apenas para CI/e2e; em operação manual use o prompt oculto do terminal; nunca defina valor real versionado)
# FLOW_ADMIN_SENHA=placeholder-apenas-ci-ou-e2e

# Porta do servidor Next.js durante os testes E2E com Playwright (padrão: 3131)
# E2E_PORT=3131
