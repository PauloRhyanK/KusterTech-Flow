# Despachante da Fábrica de agentes: unit systemd DE USUÁRIO. Instalar a unit não exige sudo; o
# despachante, ao preparar o Warren, exige `sudo -n` sem senha (veja "Requisitos da máquina de agentes"
# em fabrica/README.md).
#
# Instalação (na máquina de agentes, como o usuário que roda o Warren e o Docker):
#   mkdir -p ~/.config/systemd/user
#   cp fabrica/servico/fabrica-despachante.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now fabrica-despachante
#   loginctl enable-linger "$USER"   # continua rodando sem sessão aberta
#
# ~/fabrica/despachante.env: uma variável por linha, sem comentário no fim da linha. Só caminhos e
# nomes, NUNCA um token: os tokens ficam em arquivos próprios, e o .env aponta para eles.
#   FABRICA_RAIZ=/home/<usuário>/fabrica/<projeto>
#   FABRICA_REPO_DIR=/home/<usuário>/fabrica/<projeto>/repo
#   FABRICA_PROJETO=<projeto no Warren>
#   FABRICA_REPO=<dono>/<repositório no GitHub>
#   WARREN_API=http://127.0.0.1:8080
#   WARREN_TOKEN_FILE=/home/<usuário>/.warren-token
#   GH_TOKEN_FILE=/home/<usuário>/.warren-gh-token
# FABRICA_RAIZ guarda estado.json, plano.json, log.jsonl, acordadas.jsonl e a caixa entrada/.
# FABRICA_REPO_DIR é um clone do repositório do cliente (config e verificação).
# WARREN_API, WARREN_TOKEN_FILE e GH_TOKEN_FILE são opcionais; os valores acima são os padrões.
# FABRICA_PLANO (opcional) é o plano deste despachante: .fabrica/plano.json (o padrão) ou
# .fabrica/planos/<feature>.json, feature de a-z e 0-9 em partes separadas por um só - (nunca
# `plano`). Outro valor sai com 2.
# FABRICA_PREPARAR_WARREN=0 (opcional) desliga o preparo do Warren, que fica com o coordenador da fila.
#
# Saída 2 é entrada inválida, e o serviço NÃO reinicia (RestartPreventExitStatus=2): fica parado até
# alguém corrigir e reiniciar.
#   - .fabrica/config.json inválida ou ilegível: abre uma issue de decisão, mas só se já existe
#     estado.json deste mesmo repositório (FABRICA_REPO) em FABRICA_RAIZ;
#   - variável obrigatória ausente ou arquivo de token ilegível: sai com 2 SEM abrir issue;
#   - sem estado.json em FABRICA_RAIZ (rode iniciar antes) ou estado.json corrompido: sai com 2 SEM abrir
#     issue e sem recriar o arquivo.
# Nos dois casos, `systemctl --user status fabrica-despachante` mostra "failed" com status=2, e
# `journalctl --user -u fabrica-despachante` mostra a causa ("config inválida: ...", "defina FABRICA_RAIZ",
# "não foi possível ler o token em ...", "estado.json ilegível em ..."). Corrija e rode `systemctl --user restart fabrica-despachante`.

[Unit]
Description=Despachante da Fábrica de agentes

[Service]
Type=simple
EnvironmentFile=%h/fabrica/despachante.env
ExecStart=/usr/bin/python3 -I %h/fabrica/kit/fabrica/scripts/despachante.py rodar --intervalo 30
Restart=always
RestartSec=15
RestartPreventExitStatus=2

[Install]
WantedBy=default.target
