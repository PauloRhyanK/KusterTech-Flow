generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Papel {
  ADMIN
  APROVADOR
  TESTADOR
}

enum Tema {
  SISTEMA
  CLARO
  ESCURO
}

model Usuario {
  id           String         @id @default(uuid())
  email        String         @unique
  nome         String
  senhaHash    String
  ativo        Boolean        @default(true)
  tema         Tema           @default(SISTEMA)
  criadoEm     DateTime       @default(now())
  atualizadoEm DateTime       @updatedAt
  papeis       UsuarioPapel[]
  sessoes      Sessao[]
}

// Atenção: no Postgres NULLs são distintos no UNIQUE, então dois (usuario, ADMIN, NULL) passariam no banco.
// Decisão: não editar o SQL gerado; `criarUsuario` deduplica papéis antes de gravar, e o teste de unicidade usa clienteId não nulo.
model UsuarioPapel {
  id        String   @id @default(uuid())
  usuarioId String
  papel     Papel
  clienteId String?
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  @@unique([usuarioId, papel, clienteId])
  @@index([clienteId])
}

model Sessao {
  id          String   @id @default(uuid())
  usuarioId   String
  tokenHash   String   @unique
  criadaEm    DateTime @default(now())
  expiraEm    DateTime
  ultimoUsoEm DateTime @default(now())
  ip          String?
  userAgent   String?
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

// chave = "conta:<email normalizado>" ou "ip:<ip>"
model TentativaLogin {
  chave        String    @id
  contagem     Int
  janelaInicio DateTime
  bloqueadoAte DateTime?
}

model Cliente {
  id              String           @id @default(uuid())
  nome            String
  nomeNormalizado String           @unique
  observacoes     String?
  arquivadoEm     DateTime?
  criadoEm        DateTime         @default(now())
  atualizadoEm    DateTime         @updatedAt
  projetos        ProjetoCliente[]
  papeis          UsuarioPapel[]
}

model Projeto {
  id              String           @id @default(uuid())
  nome            String
  nomeNormalizado String           @unique
  descricao       String?
  arquivadoEm     DateTime?
  criadoEm        DateTime         @default(now())
  atualizadoEm    DateTime         @updatedAt
  clientes        ProjetoCliente[]
}

model ProjetoCliente {
  projetoId String
  clienteId String
  criadoEm  DateTime @default(now())
  projeto   Projeto  @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  @@id([projetoId, clienteId])
  @@index([clienteId])
}
