generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Papel {
  ADMIN
  APROVADOR
  TESTADOR
}

enum Tema {
  SISTEMA
  CLARO
  ESCURO
}

model Usuario {
  id                       String                  @id @default(uuid())
  email                    String                  @unique
  nome                     String
  senhaHash                String
  ativo                    Boolean                 @default(true)
  tema                     Tema                    @default(SISTEMA)
  criadoEm                 DateTime                @default(now())
  atualizadoEm             DateTime                @updatedAt
  papeis                   UsuarioPapel[]
  sessoes                  Sessao[]
  vinculosCriados          IssueVinculo[]
  eventosTimeline          EventoTimeline[]
  evidenciasRegistradas    EvidenciaDeploy[]
  presencasConfirmadas     PresencaIssueVersao[]
  tarefasGitHub            TarefaGitHub[]
  solicitacoesTriadas      SolicitacaoDeCorrecao[]
  homologacoesAprovadas    Homologacao[]
  autorizacoesProd         AutorizacaoProd[]
  verificacoesProd         VerificacaoProd[]
  divergenciasReconhecidas DivergenciaDeDeploy[]
  fontesDeAlertasCriadas   FonteDeAlertas[]
  alertasCriados           Alerta[]                @relation("AlertaCriadoPor")
  alertasReconhecidos      Alerta[]                @relation("AlertaReconhecidoPor")
  alertasResolvidos        Alerta[]                @relation("AlertaResolvidoPor")
  eventosDeAlerta          EventoDeAlerta[]
}

// Atenção: no Postgres NULLs são distintos no UNIQUE, então dois (usuario, ADMIN, NULL) passariam no banco.
// Decisão: não editar o SQL gerado; `criarUsuario` deduplica papéis antes de gravar, e o teste de unicidade usa clienteId não nulo.
model UsuarioPapel {
  id        String   @id @default(uuid())
  usuarioId String
  papel     Papel
  clienteId String?
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  @@unique([usuarioId, papel, clienteId])
  @@index([clienteId])
}

model Sessao {
  id          String   @id @default(uuid())
  usuarioId   String
  tokenHash   String   @unique
  criadaEm    DateTime @default(now())
  expiraEm    DateTime
  ultimoUsoEm DateTime @default(now())
  ip          String?
  userAgent   String?
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

// chave = "conta:<email normalizado>" ou "ip:<ip>"
model TentativaLogin {
  chave        String    @id
  contagem     Int
  janelaInicio DateTime
  bloqueadoAte DateTime?
}

model Cliente {
  id              String             @id @default(uuid())
  nome            String
  nomeNormalizado String             @unique
  observacoes     String?
  arquivadoEm     DateTime?
  criadoEm        DateTime           @default(now())
  atualizadoEm    DateTime           @updatedAt
  projetos        ProjetoCliente[]
  papeis          UsuarioPapel[]
  milestones      MilestoneCliente[]
  homologacoes    Homologacao[]
  eventos         EventoTimeline[]
}

model Projeto {
  id                      String                   @id @default(uuid())
  nome                    String
  nomeNormalizado         String                   @unique
  descricao               String?
  arquivadoEm             DateTime?
  criadoEm                DateTime                 @default(now())
  atualizadoEm            DateTime                 @updatedAt
  clientes                ProjetoCliente[]
  repositorios            RepositorioGitHub[]
  milestones              Milestone[]
  ambientes               Ambiente[]
  versoes                 Versao[]
  composicoesDePublicacao ComposicaoDePublicacao[]
  autorizacoesProd        AutorizacaoProd[]
  recursos                RecursoProjeto[]
  alertas                 Alerta[]
}

model ProjetoCliente {
  projetoId String
  clienteId String
  criadoEm  DateTime @default(now())
  projeto   Projeto  @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  @@id([projetoId, clienteId])
  @@index([clienteId])
}

enum EstadoIssueGitHub {
  ABERTA
  FECHADA
}

enum EstadoPullRequestGitHub {
  ABERTO
  FECHADO
  MERGEADO
}

enum ResumoDeChecks {
  SUCESSO
  FALHA
  PENDENTE
  SEM_CHECKS
}

// Linha única (id = "github"), gravada pelo worker.
model IntegracaoGitHub {
  id                     String    @id
  fonte                  String
  configurada            Boolean
  catalogoSincronizadoEm DateTime?
  ultimaFalhaEm          DateTime?
  ultimaFalhaMotivo      String?
  atualizadoEm           DateTime  @updatedAt
}

model RepositorioGitHub {
  id                         String                   @id @default(uuid())
  githubId                   BigInt                   @unique
  instalacaoId               BigInt
  nomeCompleto               String
  urlHtml                    String
  privado                    Boolean
  arquivadoNoGitHub          Boolean                  @default(false)
  removidoDaInstalacaoEm     DateTime?
  projetoId                  String?
  vinculadoEm                DateTime?
  sincronizadoEm             DateTime?
  sincronizacaoSolicitadaEm  DateTime?
  ultimaFalhaEm              DateTime?
  ultimaFalhaMotivo          String?
  falhasConsecutivas         Int                      @default(0)
  cursorIssues               DateTime?
  cursorPullRequests         DateTime?
  cursorDeployments          DateTime?
  deploymentsSincronizadosEm DateTime?
  deploymentsFalhaEm         DateTime?
  deploymentsFalhaMotivo     String?
  warrenLidoEm               DateTime?
  warrenFalhaEm              DateTime?
  warrenFalhaMotivo          String?
  seedsEncontrado            Boolean?
  seedsLinhasInvalidas       Int                      @default(0)
  catalogadoEm               DateTime
  projeto                    Projeto?                 @relation(fields: [projetoId], references: [id], onDelete: SetNull)
  issues                     IssueGitHub[]
  pullRequests               PullRequestGitHub[]
  versoes                    Versao[]
  tarefasGitHub              TarefaGitHub[]
  composicoesDePublicacao    ComposicaoDePublicacao[]
  autorizacoesProd           AutorizacaoProd[]
  execucoes                  ExecucaoAgente[]
  seeds                      SeedDoRepositorio[]

  @@index([projetoId])
}

model IssueGitHub {
  id                     String                  @id @default(uuid())
  githubId               BigInt                  @unique
  repositorioId          String
  numero                 Int
  titulo                 String
  corpo                  String?
  estado                 EstadoIssueGitHub
  autor                  String?
  responsaveis           String[]
  rotulos                String[]
  urlHtml                String
  criadaNoGitHub         DateTime
  atualizadaNoGitHub     DateTime
  fechadaNoGitHub        DateTime?
  sincronizadaEm         DateTime
  repositorio            RepositorioGitHub       @relation(fields: [repositorioId], references: [id], onDelete: Restrict)
  milestones             MilestoneIssue[]
  itensDeHomologacao     HomologacaoItem[]
  eventos                EventoTimeline[]
  solicitacoesDeCorrecao SolicitacaoDeCorrecao[]
  correcoes              IssueVinculo[]          @relation("VinculoOriginal")
  corrige                IssueVinculo[]          @relation("VinculoCorrecao")
  presencas              PresencaIssueVersao[]
  autorizacoesProd       AutorizacaoItem[]

  @@unique([repositorioId, numero])
}

model PullRequestGitHub {
  id                  String                  @id @default(uuid())
  githubId            BigInt                  @unique
  repositorioId       String
  numero              Int
  titulo              String
  estado              EstadoPullRequestGitHub
  rascunho            Boolean
  autor               String?
  urlHtml             String
  branch              String
  shaHead             String
  shaMerge            String?
  issuesReferenciadas Int[]
  checks              ResumoDeChecks          @default(SEM_CHECKS)
  checksAtualizadosEm DateTime?
  atualizadoNoGitHub  DateTime
  mergeadoNoGitHub    DateTime?
  sincronizadoEm      DateTime
  corpo               String?
  criadoNoGitHub      DateTime?
  repositorio         RepositorioGitHub       @relation(fields: [repositorioId], references: [id], onDelete: Restrict)
  execucao            ExecucaoAgente?

  @@unique([repositorioId, numero])
}

enum OrigemVinculoMilestone {
  MANUAL
  HERANCA_CORRECAO
}

model Milestone {
  id                String             @id @default(uuid())
  projetoId         String
  titulo            String
  tituloNormalizado String
  descricao         String?
  prazo             DateTime?          @db.Date
  arquivadaEm       DateTime?
  criadoEm          DateTime           @default(now())
  atualizadoEm      DateTime           @updatedAt
  projeto           Projeto            @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  clientes          MilestoneCliente[]
  issues            MilestoneIssue[]
  homologacoes      Homologacao[]
  eventos           EventoTimeline[]

  @@unique([projetoId, tituloNormalizado])
}

model MilestoneCliente {
  milestoneId String
  clienteId   String
  criadoEm    DateTime  @default(now())
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  cliente     Cliente   @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  @@id([milestoneId, clienteId])
  @@index([clienteId])
}

model MilestoneIssue {
  milestoneId               String
  issueId                   String
  origem                    OrigemVinculoMilestone
  foraDoEscopo              Boolean                @default(false)
  justificativaForaDoEscopo String?
  criadoEm                  DateTime               @default(now())
  milestone                 Milestone              @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  issue                     IssueGitHub            @relation(fields: [issueId], references: [id], onDelete: Restrict)

  @@id([milestoneId, issueId])
  @@index([issueId])
}

model IssueVinculo {
  id              String      @id @default(uuid())
  issueOriginalId String
  issueCorrecaoId String
  criadoPorId     String
  criadoEm        DateTime    @default(now())
  original        IssueGitHub @relation("VinculoOriginal", fields: [issueOriginalId], references: [id], onDelete: Restrict)
  correcao        IssueGitHub @relation("VinculoCorrecao", fields: [issueCorrecaoId], references: [id], onDelete: Restrict)
  criadoPor       Usuario     @relation(fields: [criadoPorId], references: [id], onDelete: Restrict)

  @@unique([issueOriginalId, issueCorrecaoId])
  @@index([issueCorrecaoId])
}

enum TipoAmbiente {
  DEV
  QA
  PROD
}

enum OrigemEvidencia {
  GITHUB_DEPLOYMENT
  ENDPOINT
  MANUAL
}

enum SituacaoEvidencia {
  SUCESSO
  FALHA
  EM_ANDAMENTO
}

enum EstadoImplantacao {
  SEM_EVIDENCIA
  PRESENCA_CONFIRMADA
  CONFIRMACAO_MANUAL
  VERIFICACAO_NECESSARIA
}

model Ambiente {
  id                 String            @id @default(uuid())
  projetoId          String
  tipo               TipoAmbiente
  nomeNoGitHub       String?
  url                String?
  tokenEvidenciaHash String?           @unique
  tokenCriadoEm      DateTime?
  criadoEm           DateTime          @default(now())
  atualizadoEm       DateTime          @updatedAt
  projeto            Projeto           @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  evidencias         EvidenciaDeploy[]

  @@unique([projetoId, tipo])
}

model Versao {
  id                      String                   @id @default(uuid())
  projetoId               String
  repositorioId           String
  commitSha               String
  rotulo                  String
  criadaEm                DateTime                 @default(now())
  projeto                 Projeto                  @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  repositorio             RepositorioGitHub        @relation(fields: [repositorioId], references: [id], onDelete: Restrict)
  evidencias              EvidenciaDeploy[]
  presencas               PresencaIssueVersao[]
  itensAvaliados          HomologacaoItem[]
  eventos                 EventoTimeline[]
  solicitacoesResolvidas  SolicitacaoDeCorrecao[]
  composicoesDePublicacao ComposicaoDePublicacao[]
  autorizacoesProd        AutorizacaoProd[]
  verificacoesProd        VerificacaoProd[]
  divergencias            DivergenciaDeDeploy[]

  @@unique([repositorioId, commitSha])
  @@index([projetoId])
}

// Só inserção (invariante 4).
model EvidenciaDeploy {
  id           String               @id @default(uuid())
  ambienteId   String
  versaoId     String
  origem       OrigemEvidencia
  situacao     SituacaoEvidencia
  ocorridaEm   DateTime
  registradaEm DateTime             @default(now())
  autorId      String?
  idExterno    String?
  detalhe      String?
  ambiente     Ambiente             @relation(fields: [ambienteId], references: [id], onDelete: Restrict)
  versao       Versao               @relation(fields: [versaoId], references: [id], onDelete: Restrict)
  autor        Usuario?             @relation(fields: [autorId], references: [id], onDelete: Restrict)
  divergencia  DivergenciaDeDeploy?

  @@unique([origem, idExterno])
  @@index([ambienteId, ocorridaEm])
  @@index([versaoId])
}

model PresencaIssueVersao {
  issueId           String
  versaoId          String
  estado            EstadoImplantacao
  motivo            String
  confirmadaPorId   String?
  calculadaEm       DateTime
  assinaturaEntrada String
  issue             IssueGitHub       @relation(fields: [issueId], references: [id], onDelete: Restrict)
  versao            Versao            @relation(fields: [versaoId], references: [id], onDelete: Restrict)
  confirmadaPor     Usuario?          @relation(fields: [confirmadaPorId], references: [id], onDelete: Restrict)

  @@id([issueId, versaoId])
  @@index([versaoId])
}

enum EstadoItemHomologacao {
  AGUARDANDO_DISPONIBILIZACAO
  PENDENTE_DE_TESTE
  CORRECAO_SOLICITADA
  AGUARDANDO_RETESTE
  APROVADA
}

enum EstadoHomologacaoMilestone {
  EM_ANDAMENTO
  APROVADA
}

enum TipoEventoTimeline {
  COMENTARIO
  ENTRADA_NA_FILA
  DISPONIBILIZACAO
  APROVACAO
  SOLICITACAO_CORRECAO
  RETESTE_DETECTADO
  RETESTE_CONFIRMADO
  TRIAGEM
  APROVACAO_MILESTONE
}

enum VisibilidadeEvento {
  INTERNA
  COMPARTILHAVEL
}

enum OrigemEvento {
  HUMANO
  SISTEMA
}

enum TipoTarefaGitHub {
  REABRIR_ISSUE
  CRIAR_ISSUE
}

enum EstadoTarefaGitHub {
  PENDENTE
  CONCLUIDA
  FALHOU
}

enum EstadoSolicitacaoCorrecao {
  ABERTA
  REABERTA_NO_GITHUB
  CORRECAO_CRIADA
  RESPONDIDA_SEM_TAREFA
  RESOLVIDA
}

model Homologacao {
  id                  String                     @id @default(uuid())
  clienteId           String
  milestoneId         String
  estado              EstadoHomologacaoMilestone @default(EM_ANDAMENTO)
  criadoEm            DateTime                   @default(now())
  atualizadoEm        DateTime                   @updatedAt
  aprovadaEm          DateTime?
  aprovadaPorId       String?
  versoesAprovadasIds String[]                   @default([])
  cliente             Cliente                    @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  milestone           Milestone                  @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  aprovadaPor         Usuario?                   @relation(fields: [aprovadaPorId], references: [id], onDelete: Restrict)
  itens               HomologacaoItem[]

  @@unique([clienteId, milestoneId])
  @@index([milestoneId])
}

model HomologacaoItem {
  id               String                  @id @default(uuid())
  homologacaoId    String
  issueId          String
  estado           EstadoItemHomologacao
  versaoAvaliadaId String?
  ultimoEventoId   String?
  criadoEm         DateTime                @default(now())
  atualizadoEm     DateTime                @updatedAt
  homologacao      Homologacao             @relation(fields: [homologacaoId], references: [id], onDelete: Restrict)
  issue            IssueGitHub             @relation(fields: [issueId], references: [id], onDelete: Restrict)
  versaoAvaliada   Versao?                 @relation(fields: [versaoAvaliadaId], references: [id], onDelete: Restrict)
  ultimoEvento     EventoTimeline?         @relation("UltimoEventoDoItem", fields: [ultimoEventoId], references: [id], onDelete: NoAction)
  solicitacoes     SolicitacaoDeCorrecao[]

  @@unique([homologacaoId, issueId])
  @@index([issueId])
  @@index([estado])
}

// Só inserção (invariante 4); estado do item e evento são gravados na mesma transação.
model EventoTimeline {
  id               String                 @id @default(uuid())
  clienteId        String
  milestoneId      String
  issueId          String?
  versaoId         String?
  tipo             TipoEventoTimeline
  visibilidade     VisibilidadeEvento
  origem           OrigemEvento
  autorId          String?
  texto            String?
  estadoAnterior   EstadoItemHomologacao?
  estadoNovo       EstadoItemHomologacao?
  eventoAnteriorId String?
  criadoEm         DateTime               @default(now())
  cliente          Cliente                @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  milestone        Milestone              @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  issue            IssueGitHub?           @relation(fields: [issueId], references: [id], onDelete: Restrict)
  versao           Versao?                @relation(fields: [versaoId], references: [id], onDelete: Restrict)
  autor            Usuario?               @relation(fields: [autorId], references: [id], onDelete: Restrict)
  eventoAnterior   EventoTimeline?        @relation("EventoAnterior", fields: [eventoAnteriorId], references: [id], onDelete: NoAction)
  eventosSeguintes EventoTimeline[]       @relation("EventoAnterior")
  itensQueApontam  HomologacaoItem[]      @relation("UltimoEventoDoItem")
  solicitacao      SolicitacaoDeCorrecao?

  @@index([clienteId, milestoneId, issueId, criadoEm])
}

model SolicitacaoDeCorrecao {
  id                  String                    @id @default(uuid())
  itemId              String
  eventoId            String                    @unique
  estado              EstadoSolicitacaoCorrecao @default(ABERTA)
  foraDoEscopo        Boolean                   @default(false)
  justificativa       String?
  issueCorrecaoId     String?
  criadoEm            DateTime                  @default(now())
  atualizadoEm        DateTime                  @updatedAt
  triadaEm            DateTime?
  triadaPorId         String?
  resolvidaEm         DateTime?
  versaoDaResolucaoId String?
  item                HomologacaoItem           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  evento              EventoTimeline            @relation(fields: [eventoId], references: [id], onDelete: Restrict)
  issueCorrecao       IssueGitHub?              @relation(fields: [issueCorrecaoId], references: [id], onDelete: Restrict)
  triadaPor           Usuario?                  @relation(fields: [triadaPorId], references: [id], onDelete: Restrict)
  versaoDaResolucao   Versao?                   @relation(fields: [versaoDaResolucaoId], references: [id], onDelete: Restrict)
  tarefasGitHub       TarefaGitHub[]

  @@index([itemId])
}

// A web grava; só o worker fala com o GitHub (5b, decisões 1 e 6).
model TarefaGitHub {
  id                 String                 @id @default(uuid())
  tipo               TipoTarefaGitHub
  repositorioId      String
  dados              Json
  estado             EstadoTarefaGitHub     @default(PENDENTE)
  tentativas         Int                    @default(0)
  resultado          Json?
  falhaMotivo        String?
  solicitadaPorId    String
  criadaEm           DateTime               @default(now())
  concluidaEm        DateTime?
  solicitacaoId      String?
  iniciadaEm         DateTime?
  proximaTentativaEm DateTime?
  repositorio        RepositorioGitHub      @relation(fields: [repositorioId], references: [id], onDelete: Restrict)
  solicitadaPor      Usuario                @relation(fields: [solicitadaPorId], references: [id], onDelete: Restrict)
  solicitacao        SolicitacaoDeCorrecao? @relation(fields: [solicitacaoId], references: [id], onDelete: Restrict)

  @@index([estado, proximaTentativaEm])
  @@index([solicitacaoId])
}

enum EstadoComposicao {
  IDENTIFICADA
  INCERTA
}

enum OrigemDaBase {
  AUTORIZACAO
  EVIDENCIA_PROD
  SEM_BASE
}

enum SituacaoItemAutorizacao {
  QA_APROVADO
  REAPROVEITADO
  VERIFICADO_POR_HUMANO
}

// Atualizada no lugar pelo worker; a autorização guarda o retrato dos itens (composicaoAutorizada).
model ComposicaoDePublicacao {
  id                   String            @id @default(uuid())
  projetoId            String
  repositorioId        String
  versaoAlvoId         String
  commitBase           String
  commitAlvo           String
  origemDaBase         OrigemDaBase
  hashComposicao       String
  estado               EstadoComposicao
  itens                Json
  aprovacoesAnteriores Json              @default("[]")
  calculadaEm          DateTime
  projeto              Projeto           @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  repositorio          RepositorioGitHub @relation(fields: [repositorioId], references: [id], onDelete: Restrict)
  versaoAlvo           Versao            @relation(fields: [versaoAlvoId], references: [id], onDelete: Restrict)
  autorizacoes         AutorizacaoProd[]

  @@unique([versaoAlvoId, commitBase])
  @@index([repositorioId, calculadaEm])
}

// Auditoria (invariante 4): nunca apagada; a revogação só marca revogadaEm.
model AutorizacaoProd {
  id                   String                 @id @default(uuid())
  projetoId            String
  repositorioId        String
  versaoAlvoId         String
  composicaoId         String
  commitBase           String
  hashComposicao       String
  autorId              String
  justificativa        String?
  composicaoAutorizada Json
  criadaEm             DateTime               @default(now())
  revogadaEm           DateTime?
  motivoRevogacao      String?
  projeto              Projeto                @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  repositorio          RepositorioGitHub      @relation(fields: [repositorioId], references: [id], onDelete: Restrict)
  composicao           ComposicaoDePublicacao @relation(fields: [composicaoId], references: [id], onDelete: Restrict)
  versaoAlvo           Versao                 @relation(fields: [versaoAlvoId], references: [id], onDelete: Restrict)
  autor                Usuario                @relation(fields: [autorId], references: [id], onDelete: Restrict)
  itens                AutorizacaoItem[]

  @@index([composicaoId])
  @@index([repositorioId, criadaEm])
  @@index([versaoAlvoId])
}

model AutorizacaoItem {
  autorizacaoId String
  issueId       String
  situacao      SituacaoItemAutorizacao
  autorizacao   AutorizacaoProd         @relation(fields: [autorizacaoId], references: [id], onDelete: Restrict)
  issue         IssueGitHub             @relation(fields: [issueId], references: [id], onDelete: Restrict)

  @@id([autorizacaoId, issueId])
  @@index([issueId])
}

// Só inserção (invariante 4); várias verificações por versão são permitidas.
model VerificacaoProd {
  id         String          @id @default(uuid())
  versaoId   String
  origem     OrigemEvidencia
  autorId    String?
  observacao String?
  criadaEm   DateTime        @default(now())
  versao     Versao          @relation(fields: [versaoId], references: [id], onDelete: Restrict)
  autor      Usuario?        @relation(fields: [autorId], references: [id], onDelete: Restrict)

  @@index([versaoId, criadaEm])
}

// Nunca apagada (invariante 7): reconhecer não autoriza, autorizar depois não a remove.
model DivergenciaDeDeploy {
  id               String          @id @default(uuid())
  evidenciaId      String          @unique
  versaoId         String
  detectadaEm      DateTime
  reconhecidaPorId String?
  reconhecidaEm    DateTime?
  evidencia        EvidenciaDeploy @relation(fields: [evidenciaId], references: [id], onDelete: Restrict)
  versao           Versao          @relation(fields: [versaoId], references: [id], onDelete: Restrict)
  reconhecidaPor   Usuario?        @relation(fields: [reconhecidaPorId], references: [id], onDelete: Restrict)

  @@index([reconhecidaEm, detectadaEm])
  @@index([versaoId])
}

enum TipoRecurso {
  SERVIDOR
  CONTAINER
  BANCO
  STORAGE
  OUTRO
}

// A ordem dos valores é a ordem da fila de alertas (orderBy do Prisma segue a declaração do enum).
enum EstadoAlerta {
  ATIVO
  RECONHECIDO
  RESOLVIDO_NA_ORIGEM
}

enum OrigemAlerta {
  WEBHOOK
  MANUAL
}

// A ordem dos valores é a ordem da fila de alertas.
enum SeveridadeAlerta {
  CRITICA
  ALTA
  MEDIA
  BAIXA
}

enum TipoEventoAlerta {
  CRIADO
  RECONHECIDO
  RESOLVIDO
  REABERTO
}

// Recurso é arquivado, nunca apagado; só um SERVIDOR hospeda (hospedadoEmId).
model Recurso {
  id                   String           @id @default(uuid())
  tipo                 TipoRecurso
  nome                 String
  nomeNormalizado      String           @unique
  identificadorExterno String?          @unique
  descricao            String?
  urlBeszel            String?
  urlGlitchTip         String?
  urlHostDocker        String?
  hospedadoEmId        String?
  arquivadoEm          DateTime?
  criadoEm             DateTime         @default(now())
  atualizadoEm         DateTime         @updatedAt
  hospedadoEm          Recurso?         @relation("RecursoHospedado", fields: [hospedadoEmId], references: [id], onDelete: Restrict)
  hospedados           Recurso[]        @relation("RecursoHospedado")
  projetos             RecursoProjeto[]
  alertas              Alerta[]

  @@index([tipo])
  @@index([hospedadoEmId])
}

model RecursoProjeto {
  recursoId String
  projetoId String
  criadoEm  DateTime @default(now())
  recurso   Recurso  @relation(fields: [recursoId], references: [id], onDelete: Cascade)
  projeto   Projeto  @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@id([recursoId, projetoId])
  @@index([projetoId])
}

// O token é mostrado uma única vez; no banco só o hash.
model FonteDeAlertas {
  id          String    @id @default(uuid())
  nome        String
  tokenHash   String    @unique
  criadoEm    DateTime  @default(now())
  revogadaEm  DateTime?
  criadaPorId String
  ultimoUsoEm DateTime?
  criadaPor   Usuario   @relation(fields: [criadaPorId], references: [id], onDelete: Restrict)
  alertas     Alerta[]
}

model Alerta {
  id                   String           @id @default(uuid())
  chaveDedupe          String           @unique
  origem               OrigemAlerta
  titulo               String
  severidade           SeveridadeAlerta
  estado               EstadoAlerta
  recursoId            String?
  projetoId            String?
  primeiraOcorrenciaEm DateTime
  ultimaOcorrenciaEm   DateTime
  ocorrencias          Int
  reconhecidoPorId     String?
  reconhecidoEm        DateTime?
  resolvidoEm          DateTime?
  detalhe              String?
  fonteId              String?
  criadoPorId          String?
  resolvidoPorId       String?
  recurso              Recurso?         @relation(fields: [recursoId], references: [id], onDelete: Restrict)
  projeto              Projeto?         @relation(fields: [projetoId], references: [id], onDelete: SetNull)
  reconhecidoPor       Usuario?         @relation("AlertaReconhecidoPor", fields: [reconhecidoPorId], references: [id], onDelete: Restrict)
  fonte                FonteDeAlertas?  @relation(fields: [fonteId], references: [id], onDelete: Restrict)
  criadoPor            Usuario?         @relation("AlertaCriadoPor", fields: [criadoPorId], references: [id], onDelete: Restrict)
  resolvidoPor         Usuario?         @relation("AlertaResolvidoPor", fields: [resolvidoPorId], references: [id], onDelete: Restrict)
  eventos              EventoDeAlerta[]

  @@index([estado, severidade])
  @@index([recursoId])
  @@index([projetoId])
}

// Só inserção (invariante 4); autorId nulo = sistema.
model EventoDeAlerta {
  id       String           @id @default(uuid())
  alertaId String
  tipo     TipoEventoAlerta
  autorId  String?
  criadoEm DateTime         @default(now())
  alerta   Alerta           @relation(fields: [alertaId], references: [id], onDelete: Cascade)
  autor    Usuario?         @relation(fields: [autorId], references: [id], onDelete: Restrict)

  @@index([alertaId, criadoEm])
}

enum EstadoExecucao {
  NA_FILA
  AGUARDANDO_CAPACIDADE
  AGUARDANDO_DEPENDENCIA
  EXECUTANDO
  INTERVENCAO_NECESSARIA
  CONCLUIDA
  SEM_DADOS
}

enum StatusDeSeed {
  ABERTA
  EM_ANDAMENTO
  FECHADA
}

model ExecucaoAgente {
  id             String             @id @default(uuid())
  repositorioId  String
  runId          String             @unique
  seedId         String?
  papel          String?
  agente         String?
  estado         EstadoExecucao
  motivoDoEstado String
  iniciadaEm     DateTime?
  atualizadaEm   DateTime
  sincronizadaEm DateTime
  pullRequestId  String?            @unique
  custo          Decimal?           @db.Decimal(12, 4)
  fonte          String
  repositorio    RepositorioGitHub  @relation(fields: [repositorioId], references: [id], onDelete: Restrict)
  pullRequest    PullRequestGitHub? @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)

  @@index([repositorioId, seedId])
}

model SeedDoRepositorio {
  id                String            @id @default(uuid())
  repositorioId     String
  seedId            String
  titulo            String
  status            StatusDeSeed
  tipo              String
  planoId           String?
  planoNome         String?
  bloqueadaPor      String[]
  atualizadaNoSeeds DateTime?
  ausenteDesde      DateTime?
  lidaEm            DateTime
  repositorio       RepositorioGitHub @relation(fields: [repositorioId], references: [id], onDelete: Restrict)

  @@unique([repositorioId, seedId])
}
