generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Papel {
  ADMIN
  APROVADOR
  TESTADOR
}

enum Tema {
  SISTEMA
  CLARO
  ESCURO
}

model Usuario {
  id                        String                  @id @default(uuid())
  email                     String                  @unique
  nome                      String
  senhaHash                 String
  ativo                     Boolean                 @default(true)
  tema                      Tema                    @default(SISTEMA)
  criadoEm                  DateTime                @default(now())
  atualizadoEm              DateTime                @updatedAt
  papeis                    UsuarioPapel[]
  sessoes                   Sessao[]
  vinculosCriados           IssueVinculo[]
  eventosTimeline           EventoTimeline[]
  evidenciasRegistradas     EvidenciaDeploy[]
  presencasConfirmadas      PresencaIssueVersao[]
  tarefasGitHub             TarefaGitHub[]
  solicitacoesTriadas       SolicitacaoDeCorrecao[]
  homologacoesAprovadas     Homologacao[]
  autorizacoesProd          AutorizacaoProd[]
  verificacoesProd          VerificacaoProd[]
  divergenciasReconhecidas  DivergenciaDeDeploy[]
  fontesDaFabricaCriadas    FonteDaFabrica[]
  fontesDePublicacaoCriadas FonteDePublicacao[]
  pedidosDePublicacao       PedidoDePublicacao[]
  demandasCriadas           Demanda[]
  partesConferidas          ParteDaDemanda[]
  mensagensEscritas         Mensagem[]
  cartoesConfirmados        CartaoDeFecho[]
  fontesDeDemandasCriadas   FonteDeDemandas[]
  buscasDeDemandas          BuscaDeDemandas[]
}

// Atenção: no Postgres NULLs são distintos no UNIQUE, então dois (usuario, ADMIN, NULL) passariam no banco.
// Decisão: não editar o SQL gerado; `criarUsuario` deduplica papéis antes de gravar, e o teste de unicidade usa clienteId não nulo.
model UsuarioPapel {
  id        String   @id @default(uuid())
  usuarioId String
  papel     Papel
  clienteId String?
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  cliente   Cliente? @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  @@unique([usuarioId, papel, clienteId])
  @@index([clienteId])
}

model Sessao {
  id          String   @id @default(uuid())
  usuarioId   String
  tokenHash   String   @unique
  criadaEm    DateTime @default(now())
  expiraEm    DateTime
  ultimoUsoEm DateTime @default(now())
  ip          String?
  userAgent   String?
  usuario     Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
}

// chave = "conta:<email normalizado>" ou "ip:<ip>"
model TentativaLogin {
  chave        String    @id
  contagem     Int
  janelaInicio DateTime
  bloqueadoAte DateTime?
}

model Cliente {
  id              String             @id @default(uuid())
  nome            String
  nomeNormalizado String             @unique
  observacoes     String?
  arquivadoEm     DateTime?
  criadoEm        DateTime           @default(now())
  atualizadoEm    DateTime           @updatedAt
  projetos        ProjetoCliente[]
  papeis          UsuarioPapel[]
  milestones      MilestoneCliente[]
  homologacoes    Homologacao[]
  eventos         EventoTimeline[]
}

model Projeto {
  id                      String                   @id @default(uuid())
  nome                    String
  nomeNormalizado         String                   @unique
  descricao               String?
  arquivadoEm             DateTime?
  criadoEm                DateTime                 @default(now())
  atualizadoEm            DateTime                 @updatedAt
  clientes                ProjetoCliente[]
  repositorios            RepositorioGitHub[]
  milestones              Milestone[]
  ambientes               Ambiente[]
  versoes                 Versao[]
  composicoesDePublicacao ComposicaoDePublicacao[]
  autorizacoesProd        AutorizacaoProd[]
  recursos                RecursoProjeto[]
  modeloDeEtapasId        String?
  nivelPadraoDeDemanda    NivelDeAcompanhamento    @default(APROVAR_DESENHO)
  modeloDeEtapas          ModeloDeEtapas?          @relation(fields: [modeloDeEtapasId], references: [id], onDelete: SetNull)
  demandas                Demanda[]
  sistemasConectados      SistemaConectado[]
}

model ProjetoCliente {
  projetoId String
  clienteId String
  criadoEm  DateTime @default(now())
  projeto   Projeto  @relation(fields: [projetoId], references: [id], onDelete: Cascade)
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  @@id([projetoId, clienteId])
  @@index([clienteId])
}

enum EstadoIssueGitHub {
  ABERTA
  FECHADA
}

enum EstadoPullRequestGitHub {
  ABERTO
  FECHADO
  MERGEADO
}

enum ResumoDeChecks {
  SUCESSO
  FALHA
  PENDENTE
  SEM_CHECKS
}

// Linha única (id = "github"), gravada pelo worker.
model IntegracaoGitHub {
  id                     String    @id
  fonte                  String
  configurada            Boolean
  catalogoSincronizadoEm DateTime?
  catalogoSolicitadoEm   DateTime?
  ultimaFalhaEm          DateTime?
  ultimaFalhaMotivo      String?
  atualizadoEm           DateTime  @updatedAt
}

model EventoIntegracao {
  id                  String    @id @default(uuid())
  deliveryId          String    @unique // X-GitHub-Delivery
  evento              String // X-GitHub-Event, sempre de EVENTOS_DE_WEBHOOK
  repositorioGitHubId BigInt? // repository.id do payload; sem FK (pode não estar no catálogo)
  recebidoEm          DateTime  @default(now())
  processadoEm        DateTime?
  tentativas          Int       @default(0)
  falhaMotivo         String?

  @@index([processadoEm, recebidoEm])
}

model RepositorioGitHub {
  id                         String                    @id @default(uuid())
  githubId                   BigInt                    @unique
  instalacaoId               BigInt
  nomeCompleto               String
  urlHtml                    String
  privado                    Boolean
  arquivadoNoGitHub          Boolean                   @default(false)
  removidoDaInstalacaoEm     DateTime?
  projetoId                  String?
  vinculadoEm                DateTime?
  sincronizadoEm             DateTime?
  sincronizacaoSolicitadaEm  DateTime?
  ultimaFalhaEm              DateTime?
  ultimaFalhaMotivo          String?
  falhasConsecutivas         Int                       @default(0)
  cursorIssues               DateTime?
  cursorPullRequests         DateTime?
  cursorDeployments          DateTime?
  deploymentsSincronizadosEm DateTime?
  deploymentsFalhaEm         DateTime?
  deploymentsFalhaMotivo     String?
  warrenLidoEm               DateTime?
  warrenFalhaEm              DateTime?
  warrenFalhaMotivo          String?
  seedsEncontrado            Boolean?
  seedsLinhasInvalidas       Int                       @default(0)
  catalogadoEm               DateTime
  projeto                    Projeto?                  @relation(fields: [projetoId], references: [id], onDelete: SetNull)
  issues                     IssueGitHub[]
  errosDoGlitchTip           ErroDoGlitchTip[]
  pullRequests               PullRequestGitHub[]
  demandas                   Demanda[]
  partes                     ParteDaDemanda[]
  versoes                    Versao[]
  tarefasGitHub              TarefaGitHub[]
  composicoesDePublicacao    ComposicaoDePublicacao[]
  autorizacoesProd           AutorizacaoProd[]
  execucoes                  ExecucaoAgente[]
  seeds                      SeedDoRepositorio[]
  configuracaoDePublicacao   ConfiguracaoDePublicacao?
  pedidosDePublicacao        PedidoDePublicacao[]
  consertosDePublicacao      PedidoDeConserto[]
  sistemasConectados         SistemaConectado[]

  @@index([projetoId])
}

model IssueGitHub {
  id                     String                  @id @default(uuid())
  githubId               BigInt                  @unique
  repositorioId          String
  numero                 Int
  titulo                 String
  corpo                  String?
  estado                 EstadoIssueGitHub
  autor                  String?
  responsaveis           String[]
  rotulos                String[]
  urlHtml                String
  criadaNoGitHub         DateTime
  atualizadaNoGitHub     DateTime
  fechadaNoGitHub        DateTime?
  sincronizadaEm         DateTime
  repositorio            RepositorioGitHub       @relation(fields: [repositorioId], references: [id], onDelete: Restrict)
  milestones             MilestoneIssue[]
  itensDeHomologacao     HomologacaoItem[]
  eventos                EventoTimeline[]
  solicitacoesDeCorrecao SolicitacaoDeCorrecao[]
  correcoes              IssueVinculo[]          @relation("VinculoOriginal")
  corrige                IssueVinculo[]          @relation("VinculoCorrecao")
  presencas              PresencaIssueVersao[]
  autorizacoesProd       AutorizacaoItem[]

  @@unique([repositorioId, numero])
}

model PullRequestGitHub {
  id                  String                  @id @default(uuid())
  githubId            BigInt                  @unique
  repositorioId       String
  numero              Int
  titulo              String
  estado              EstadoPullRequestGitHub
  rascunho            Boolean
  autor               String?
  urlHtml             String
  branch              String
  shaHead             String
  shaMerge            String?
  issuesReferenciadas Int[]
  checks              ResumoDeChecks          @default(SEM_CHECKS)
  checksAtualizadosEm DateTime?
  atualizadoNoGitHub  DateTime
  mergeadoNoGitHub    DateTime?
  sincronizadoEm      DateTime
  corpo               String?
  criadoNoGitHub      DateTime?
  repositorio         RepositorioGitHub       @relation(fields: [repositorioId], references: [id], onDelete: Restrict)
  execucao            ExecucaoAgente?

  @@unique([repositorioId, numero])
}

enum OrigemVinculoMilestone {
  MANUAL
  HERANCA_CORRECAO
}

model Milestone {
  id                String             @id @default(uuid())
  projetoId         String
  titulo            String
  tituloNormalizado String
  descricao         String?
  prazo             DateTime?          @db.Date
  arquivadaEm       DateTime?
  criadoEm          DateTime           @default(now())
  atualizadoEm      DateTime           @updatedAt
  projeto           Projeto            @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  clientes          MilestoneCliente[]
  issues            MilestoneIssue[]
  homologacoes      Homologacao[]
  eventos           EventoTimeline[]

  @@unique([projetoId, tituloNormalizado])
}

model MilestoneCliente {
  milestoneId String
  clienteId   String
  criadoEm    DateTime  @default(now())
  milestone   Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  cliente     Cliente   @relation(fields: [clienteId], references: [id], onDelete: Restrict)

  @@id([milestoneId, clienteId])
  @@index([clienteId])
}

model MilestoneIssue {
  milestoneId               String
  issueId                   String
  origem                    OrigemVinculoMilestone
  foraDoEscopo              Boolean                @default(false)
  justificativaForaDoEscopo String?
  criadoEm                  DateTime               @default(now())
  milestone                 Milestone              @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  issue                     IssueGitHub            @relation(fields: [issueId], references: [id], onDelete: Restrict)

  @@id([milestoneId, issueId])
  @@index([issueId])
}

model IssueVinculo {
  id              String      @id @default(uuid())
  issueOriginalId String
  issueCorrecaoId String
  criadoPorId     String
  criadoEm        DateTime    @default(now())
  original        IssueGitHub @relation("VinculoOriginal", fields: [issueOriginalId], references: [id], onDelete: Restrict)
  correcao        IssueGitHub @relation("VinculoCorrecao", fields: [issueCorrecaoId], references: [id], onDelete: Restrict)
  criadoPor       Usuario     @relation(fields: [criadoPorId], references: [id], onDelete: Restrict)

  @@unique([issueOriginalId, issueCorrecaoId])
  @@index([issueCorrecaoId])
}

enum TipoAmbiente {
  DEV
  QA
  PROD
}

enum OrigemEvidencia {
  GITHUB_DEPLOYMENT
  ENDPOINT
  MANUAL
}

enum SituacaoEvidencia {
  SUCESSO
  FALHA
  EM_ANDAMENTO
}

enum EstadoImplantacao {
  SEM_EVIDENCIA
  PRESENCA_CONFIRMADA
  CONFIRMACAO_MANUAL
  VERIFICACAO_NECESSARIA
}

model Ambiente {
  id                 String            @id @default(uuid())
  projetoId          String
  tipo               TipoAmbiente
  nomeNoGitHub       String?
  url                String?
  tokenEvidenciaHash String?           @unique
  tokenCriadoEm      DateTime?
  criadoEm           DateTime          @default(now())
  atualizadoEm       DateTime          @updatedAt
  projeto            Projeto           @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  evidencias         EvidenciaDeploy[]

  @@unique([projetoId, tipo])
}

model Versao {
  id                      String                   @id @default(uuid())
  projetoId               String
  repositorioId           String
  commitSha               String
  rotulo                  String
  criadaEm                DateTime                 @default(now())
  projeto                 Projeto                  @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  repositorio             RepositorioGitHub        @relation(fields: [repositorioId], references: [id], onDelete: Restrict)
  evidencias              EvidenciaDeploy[]
  presencas               PresencaIssueVersao[]
  itensAvaliados          HomologacaoItem[]
  eventos                 EventoTimeline[]
  solicitacoesResolvidas  SolicitacaoDeCorrecao[]
  composicoesDePublicacao ComposicaoDePublicacao[]
  autorizacoesProd        AutorizacaoProd[]
  verificacoesProd        VerificacaoProd[]
  divergencias            DivergenciaDeDeploy[]

  @@unique([repositorioId, commitSha])
  @@index([projetoId])
}

// Só inserção (invariante 4).
model EvidenciaDeploy {
  id           String               @id @default(uuid())
  ambienteId   String
  versaoId     String
  origem       OrigemEvidencia
  situacao     SituacaoEvidencia
  ocorridaEm   DateTime
  registradaEm DateTime             @default(now())
  autorId      String?
  idExterno    String?
  detalhe      String?
  ambiente     Ambiente             @relation(fields: [ambienteId], references: [id], onDelete: Restrict)
  versao       Versao               @relation(fields: [versaoId], references: [id], onDelete: Restrict)
  autor        Usuario?             @relation(fields: [autorId], references: [id], onDelete: Restrict)
  divergencia  DivergenciaDeDeploy?

  @@unique([origem, idExterno])
  @@index([ambienteId, ocorridaEm])
  @@index([versaoId])
}

model PresencaIssueVersao {
  issueId           String
  versaoId          String
  estado            EstadoImplantacao
  motivo            String
  confirmadaPorId   String?
  calculadaEm       DateTime
  assinaturaEntrada String
  issue             IssueGitHub       @relation(fields: [issueId], references: [id], onDelete: Restrict)
  versao            Versao            @relation(fields: [versaoId], references: [id], onDelete: Restrict)
  confirmadaPor     Usuario?          @relation(fields: [confirmadaPorId], references: [id], onDelete: Restrict)

  @@id([issueId, versaoId])
  @@index([versaoId])
}

enum EstadoItemHomologacao {
  AGUARDANDO_DISPONIBILIZACAO
  PENDENTE_DE_TESTE
  CORRECAO_SOLICITADA
  AGUARDANDO_RETESTE
  APROVADA
}

enum EstadoHomologacaoMilestone {
  EM_ANDAMENTO
  APROVADA
}

enum TipoEventoTimeline {
  COMENTARIO
  ENTRADA_NA_FILA
  DISPONIBILIZACAO
  APROVACAO
  SOLICITACAO_CORRECAO
  RETESTE_DETECTADO
  RETESTE_CONFIRMADO
  TRIAGEM
  APROVACAO_MILESTONE
}

enum VisibilidadeEvento {
  INTERNA
  COMPARTILHAVEL
}

enum OrigemEvento {
  HUMANO
  SISTEMA
}

enum TipoTarefaGitHub {
  REABRIR_ISSUE
  CRIAR_ISSUE
}

enum EstadoTarefaGitHub {
  PENDENTE
  CONCLUIDA
  FALHOU
}

enum EstadoSolicitacaoCorrecao {
  ABERTA
  REABERTA_NO_GITHUB
  CORRECAO_CRIADA
  RESPONDIDA_SEM_TAREFA
  RESOLVIDA
}

model Homologacao {
  id                  String                     @id @default(uuid())
  clienteId           String
  milestoneId         String
  estado              EstadoHomologacaoMilestone @default(EM_ANDAMENTO)
  criadoEm            DateTime                   @default(now())
  atualizadoEm        DateTime                   @updatedAt
  aprovadaEm          DateTime?
  aprovadaPorId       String?
  versoesAprovadasIds String[]                   @default([])
  cliente             Cliente                    @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  milestone           Milestone                  @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  aprovadaPor         Usuario?                   @relation(fields: [aprovadaPorId], references: [id], onDelete: Restrict)
  itens               HomologacaoItem[]

  @@unique([clienteId, milestoneId])
  @@index([milestoneId])
}

model HomologacaoItem {
  id               String                  @id @default(uuid())
  homologacaoId    String
  issueId          String
  estado           EstadoItemHomologacao
  versaoAvaliadaId String?
  ultimoEventoId   String?
  criadoEm         DateTime                @default(now())
  atualizadoEm     DateTime                @updatedAt
  homologacao      Homologacao             @relation(fields: [homologacaoId], references: [id], onDelete: Restrict)
  issue            IssueGitHub             @relation(fields: [issueId], references: [id], onDelete: Restrict)
  versaoAvaliada   Versao?                 @relation(fields: [versaoAvaliadaId], references: [id], onDelete: Restrict)
  ultimoEvento     EventoTimeline?         @relation("UltimoEventoDoItem", fields: [ultimoEventoId], references: [id], onDelete: NoAction)
  solicitacoes     SolicitacaoDeCorrecao[]

  @@unique([homologacaoId, issueId])
  @@index([issueId])
  @@index([estado])
}

// Só inserção (invariante 4); estado do item e evento são gravados na mesma transação.
model EventoTimeline {
  id               String                 @id @default(uuid())
  clienteId        String
  milestoneId      String
  issueId          String?
  versaoId         String?
  tipo             TipoEventoTimeline
  visibilidade     VisibilidadeEvento
  origem           OrigemEvento
  autorId          String?
  texto            String?
  estadoAnterior   EstadoItemHomologacao?
  estadoNovo       EstadoItemHomologacao?
  eventoAnteriorId String?
  criadoEm         DateTime               @default(now())
  cliente          Cliente                @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  milestone        Milestone              @relation(fields: [milestoneId], references: [id], onDelete: Restrict)
  issue            IssueGitHub?           @relation(fields: [issueId], references: [id], onDelete: Restrict)
  versao           Versao?                @relation(fields: [versaoId], references: [id], onDelete: Restrict)
  autor            Usuario?               @relation(fields: [autorId], references: [id], onDelete: Restrict)
  eventoAnterior   EventoTimeline?        @relation("EventoAnterior", fields: [eventoAnteriorId], references: [id], onDelete: NoAction)
  eventosSeguintes EventoTimeline[]       @relation("EventoAnterior")
  itensQueApontam  HomologacaoItem[]      @relation("UltimoEventoDoItem")
  solicitacao      SolicitacaoDeCorrecao?

  @@index([clienteId, milestoneId, issueId, criadoEm])
}

model SolicitacaoDeCorrecao {
  id                  String                    @id @default(uuid())
  itemId              String
  eventoId            String                    @unique
  estado              EstadoSolicitacaoCorrecao @default(ABERTA)
  foraDoEscopo        Boolean                   @default(false)
  justificativa       String?
  issueCorrecaoId     String?
  criadoEm            DateTime                  @default(now())
  atualizadoEm        DateTime                  @updatedAt
  triadaEm            DateTime?
  triadaPorId         String?
  resolvidaEm         DateTime?
  versaoDaResolucaoId String?
  item                HomologacaoItem           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  evento              EventoTimeline            @relation(fields: [eventoId], references: [id], onDelete: Restrict)
  issueCorrecao       IssueGitHub?              @relation(fields: [issueCorrecaoId], references: [id], onDelete: Restrict)
  triadaPor           Usuario?                  @relation(fields: [triadaPorId], references: [id], onDelete: Restrict)
  versaoDaResolucao   Versao?                   @relation(fields: [versaoDaResolucaoId], references: [id], onDelete: Restrict)
  tarefasGitHub       TarefaGitHub[]

  @@index([itemId])
}

// A web grava; só o worker fala com o GitHub (5b, decisões 1 e 6).
model TarefaGitHub {
  id                 String                 @id @default(uuid())
  tipo               TipoTarefaGitHub
  repositorioId      String
  dados              Json
  estado             EstadoTarefaGitHub     @default(PENDENTE)
  tentativas         Int                    @default(0)
  resultado          Json?
  falhaMotivo        String?
  solicitadaPorId    String
  criadaEm           DateTime               @default(now())
  concluidaEm        DateTime?
  solicitacaoId      String?
  iniciadaEm         DateTime?
  proximaTentativaEm DateTime?
  repositorio        RepositorioGitHub      @relation(fields: [repositorioId], references: [id], onDelete: Restrict)
  solicitadaPor      Usuario                @relation(fields: [solicitadaPorId], references: [id], onDelete: Restrict)
  solicitacao        SolicitacaoDeCorrecao? @relation(fields: [solicitacaoId], references: [id], onDelete: Restrict)

  @@index([estado, proximaTentativaEm])
  @@index([solicitacaoId])
}

enum EstadoComposicao {
  IDENTIFICADA
  INCERTA
}

enum OrigemDaBase {
  AUTORIZACAO
  EVIDENCIA_PROD
  SEM_BASE
}

enum SituacaoItemAutorizacao {
  QA_APROVADO
  REAPROVEITADO
  VERIFICADO_POR_HUMANO
}

// Atualizada no lugar pelo worker; a autorização guarda o retrato dos itens (composicaoAutorizada).
model ComposicaoDePublicacao {
  id                   String            @id @default(uuid())
  projetoId            String
  repositorioId        String
  versaoAlvoId         String
  commitBase           String
  commitAlvo           String
  origemDaBase         OrigemDaBase
  hashComposicao       String
  estado               EstadoComposicao
  itens                Json
  aprovacoesAnteriores Json              @default("[]")
  calculadaEm          DateTime
  projeto              Projeto           @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  repositorio          RepositorioGitHub @relation(fields: [repositorioId], references: [id], onDelete: Restrict)
  versaoAlvo           Versao            @relation(fields: [versaoAlvoId], references: [id], onDelete: Restrict)
  autorizacoes         AutorizacaoProd[]

  @@unique([versaoAlvoId, commitBase])
  @@index([repositorioId, calculadaEm])
}

// Auditoria (invariante 4): nunca apagada; a revogação só marca revogadaEm.
model AutorizacaoProd {
  id                   String                 @id @default(uuid())
  projetoId            String
  repositorioId        String
  versaoAlvoId         String
  composicaoId         String
  commitBase           String
  hashComposicao       String
  autorId              String
  justificativa        String?
  composicaoAutorizada Json
  criadaEm             DateTime               @default(now())
  revogadaEm           DateTime?
  motivoRevogacao      String?
  projeto              Projeto                @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  repositorio          RepositorioGitHub      @relation(fields: [repositorioId], references: [id], onDelete: Restrict)
  composicao           ComposicaoDePublicacao @relation(fields: [composicaoId], references: [id], onDelete: Restrict)
  versaoAlvo           Versao                 @relation(fields: [versaoAlvoId], references: [id], onDelete: Restrict)
  autor                Usuario                @relation(fields: [autorId], references: [id], onDelete: Restrict)
  itens                AutorizacaoItem[]

  @@index([composicaoId])
  @@index([repositorioId, criadaEm])
  @@index([versaoAlvoId])
}

model AutorizacaoItem {
  autorizacaoId String
  issueId       String
  situacao      SituacaoItemAutorizacao
  autorizacao   AutorizacaoProd         @relation(fields: [autorizacaoId], references: [id], onDelete: Restrict)
  issue         IssueGitHub             @relation(fields: [issueId], references: [id], onDelete: Restrict)

  @@id([autorizacaoId, issueId])
  @@index([issueId])
}

// Só inserção (invariante 4); várias verificações por versão são permitidas.
model VerificacaoProd {
  id         String          @id @default(uuid())
  versaoId   String
  origem     OrigemEvidencia
  autorId    String?
  observacao String?
  criadaEm   DateTime        @default(now())
  versao     Versao          @relation(fields: [versaoId], references: [id], onDelete: Restrict)
  autor      Usuario?        @relation(fields: [autorId], references: [id], onDelete: Restrict)

  @@index([versaoId, criadaEm])
}

// Nunca apagada (invariante 7): reconhecer não autoriza, autorizar depois não a remove.
model DivergenciaDeDeploy {
  id               String          @id @default(uuid())
  evidenciaId      String          @unique
  versaoId         String
  detectadaEm      DateTime
  reconhecidaPorId String?
  reconhecidaEm    DateTime?
  evidencia        EvidenciaDeploy @relation(fields: [evidenciaId], references: [id], onDelete: Restrict)
  versao           Versao          @relation(fields: [versaoId], references: [id], onDelete: Restrict)
  reconhecidaPor   Usuario?        @relation(fields: [reconhecidaPorId], references: [id], onDelete: Restrict)

  @@index([reconhecidaEm, detectadaEm])
  @@index([versaoId])
}

enum TipoRecurso {
  SERVIDOR
  CONTAINER
  BANCO
  STORAGE
  OUTRO
}

// Recurso é arquivado, nunca apagado; só um SERVIDOR hospeda (hospedadoEmId).
model Recurso {
  id                   String           @id @default(uuid())
  tipo                 TipoRecurso
  nome                 String
  nomeNormalizado      String           @unique
  identificadorExterno String?          @unique
  descricao            String?
  provedor             String?
  endereco             String?
  especificacao        String?
  custoMensal          Decimal?         @db.Decimal(10, 2)
  hospedadoEmId        String?
  arquivadoEm          DateTime?
  criadoEm             DateTime         @default(now())
  atualizadoEm         DateTime         @updatedAt
  hospedadoEm          Recurso?         @relation("RecursoHospedado", fields: [hospedadoEmId], references: [id], onDelete: Restrict)
  hospedados           Recurso[]        @relation("RecursoHospedado")
  projetos             RecursoProjeto[]

  @@index([tipo])
  @@index([hospedadoEmId])
}

model RecursoProjeto {
  recursoId String
  projetoId String
  criadoEm  DateTime @default(now())
  recurso   Recurso  @relation(fields: [recursoId], references: [id], onDelete: Cascade)
  projeto   Projeto  @relation(fields: [projetoId], references: [id], onDelete: Cascade)

  @@id([recursoId, projetoId])
  @@index([projetoId])
}

// O token (prefixo ff_) é mostrado uma única vez; no banco só o hash.
model FonteDaFabrica {
  id                  String            @id @default(uuid())
  nome                String
  tokenHash           String            @unique
  criadoEm            DateTime          @default(now())
  revogadaEm          DateTime?
  criadaPorId         String
  ultimoUsoEm         DateTime?
  demandasBuscadasEm  DateTime?
  conversasBuscadasEm DateTime?
  criadaPor           Usuario           @relation(fields: [criadaPorId], references: [id], onDelete: Restrict)
  retrato             RetratoDaFabrica?
}

// Só o último retrato de cada fonte; `conteudo` é o JSON validado pelo contrato v1.
model RetratoDaFabrica {
  fonteId    String         @id
  geradoEm   DateTime
  recebidoEm DateTime
  conteudo   Json
  fonte      FonteDaFabrica @relation(fields: [fonteId], references: [id], onDelete: Cascade)
}

enum EstadoExecucao {
  NA_FILA
  AGUARDANDO_CAPACIDADE
  AGUARDANDO_DEPENDENCIA
  EXECUTANDO
  INTERVENCAO_NECESSARIA
  CONCLUIDA
  SEM_DADOS
}

enum StatusDeSeed {
  ABERTA
  EM_ANDAMENTO
  FECHADA
}

model ExecucaoAgente {
  id             String             @id @default(uuid())
  repositorioId  String
  runId          String             @unique
  seedId         String?
  papel          String?
  agente         String?
  estado         EstadoExecucao
  motivoDoEstado String
  iniciadaEm     DateTime?
  atualizadaEm   DateTime
  sincronizadaEm DateTime
  pullRequestId  String?            @unique
  custo          Decimal?           @db.Decimal(12, 4)
  fonte          String
  repositorio    RepositorioGitHub  @relation(fields: [repositorioId], references: [id], onDelete: Restrict)
  pullRequest    PullRequestGitHub? @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)

  @@index([repositorioId, seedId])
}

model SeedDoRepositorio {
  id                String            @id @default(uuid())
  repositorioId     String
  seedId            String
  titulo            String
  status            StatusDeSeed
  tipo              String
  planoId           String?
  planoNome         String?
  bloqueadaPor      String[]
  atualizadaNoSeeds DateTime?
  ausenteDesde      DateTime?
  lidaEm            DateTime
  repositorio       RepositorioGitHub @relation(fields: [repositorioId], references: [id], onDelete: Restrict)

  @@unique([repositorioId, seedId])
}

enum ModoDePublicacao {
  IMEDIATO
  LOTE
}

enum EstadoDoPedidoDePublicacao {
  NA_FILA
  VERIFICANDO
  PUBLICANDO
  PUBLICADO
  RECUSADO
  DISPENSADO
  FALHOU
  CANCELADO
}

enum SituacaoDaFilaDePublicacao {
  NORMAL
  CONSERTANDO
  PARADO
}

enum EstadoDoPedidoDeConserto {
  ABERTO
  EM_CURSO
  COM_PR
  RESOLVIDO
  DESISTIU
}

model ConfiguracaoDePublicacao {
  repositorioId     String                     @id
  workflow          String
  entradaDoCommit   String                     @default("commit")
  horaDoLote        String                     @default("22:00")
  modoPadrao        ModoDePublicacao           @default(IMEDIATO)
  automatico        Boolean                    @default(true)
  pausado           Boolean                    @default(false)
  situacao          SituacaoDaFilaDePublicacao @default(NORMAL)
  situacaoDesde     DateTime?
  situacaoMotivo    String?
  ultimoLoteEm      DateTime?
  baseRedefinidaEm  DateTime?
  // A versão no ar: o site publica {"commit": "<sha>"} nesta URL e o Flow confere depois do deploy.
  urlDaVersao       String?
  versaoNoAr        String?
  versaoConferidaEm DateTime?
  atualizadoEm      DateTime                   @updatedAt
  repositorio       RepositorioGitHub          @relation(fields: [repositorioId], references: [id], onDelete: Cascade)
}

// Linha única (id = 1).
model PausaGeralDePublicacao {
  id           Int       @id @default(1)
  pausadaEm    DateTime?
  pausadaPorId String?
}

// O token é mostrado uma única vez; no banco só o hash.
model FonteDePublicacao {
  id          String               @id @default(uuid())
  nome        String
  tokenHash   String               @unique
  criadoEm    DateTime             @default(now())
  revogadaEm  DateTime?
  criadaPorId String
  ultimoUsoEm DateTime?
  criadaPor   Usuario              @relation(fields: [criadaPorId], references: [id], onDelete: Restrict)
  pedidos     PedidoDePublicacao[]
}

// Índice único parcial "um por vez" é criado à mão na migration.
model PedidoDePublicacao {
  id               String                     @id @default(uuid())
  repositorioId    String
  commit           String?
  // Pedido sem commit ("a ponta de main"): o worker troca o commit pela cabeça de main até o disparo.
  segueMain        Boolean                    @default(false)
  modo             ModoDePublicacao
  descricao        String?
  fonteId          String?
  usuarioId        String?
  consertoId       String?                    @unique
  estado           EstadoDoPedidoDePublicacao @default(NA_FILA)
  motivo           String?
  atendidoPorId    String?
  verificadoContra String?
  execucaoId       BigInt?
  execucaoUrl      String?
  disparoTentadoEm DateTime?
  checks           ResumoDeChecks?
  loteEm           DateTime?
  criadoEm         DateTime                   @default(now())
  verificandoDesde DateTime?
  iniciadoEm       DateTime?
  // O workflow terminou verde e o Flow está conferindo a versão no ar.
  conferindoDesde  DateTime?
  concluidoEm      DateTime?
  repositorio      RepositorioGitHub          @relation(fields: [repositorioId], references: [id], onDelete: Cascade)
  fonte            FonteDePublicacao?         @relation(fields: [fonteId], references: [id], onDelete: SetNull)
  usuario          Usuario?                   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  conserto         PedidoDeConserto?
  demandaId        String?
  demanda          Demanda?                   @relation(fields: [demandaId], references: [id], onDelete: SetNull)
  parteId          String?
  parte            ParteDaDemanda?            @relation(fields: [parteId], references: [id], onDelete: SetNull)

  @@index([repositorioId, estado])
  @@index([demandaId])
  @@index([parteId])
}

model PedidoDeConserto {
  id            String                   @id @default(uuid())
  repositorioId String
  pedidoId      String                   @unique
  commit        String
  execucaoUrl   String?
  trechoDoLog   String
  estado        EstadoDoPedidoDeConserto @default(ABERTO)
  runId         String?
  prUrl         String?
  motivo        String?
  shaDaCorrecao String?
  abertoEm      DateTime                 @default(now())
  pegoEm        DateTime?
  encerradoEm   DateTime?
  repositorio   RepositorioGitHub        @relation(fields: [repositorioId], references: [id], onDelete: Cascade)
  pedido        PedidoDePublicacao       @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  demandaId     String?
  parteId       String?
  demanda       Demanda?                 @relation(fields: [demandaId], references: [id], onDelete: SetNull)
  parte         ParteDaDemanda?          @relation(fields: [parteId], references: [id], onDelete: SetNull)

  @@index([estado])
}

enum NivelDeAcompanhamento {
  PLANEJAR_COMIGO
  APROVAR_DESENHO
  VAI_SOZINHO
}

enum DestinoDaDemanda {
  URGENTE
  LOTE_DA_NOITE
  FILA_DE_AGENTES
  DECISAO_DO_PAULO
  ORIENTADA
}

enum TipoDeDemanda {
  DEFEITO
  IDEIA
  AJUSTE
  FUNCAO_NOVA
}

enum OrigemDaDemanda {
  FLOW
  SESSAO
  FABRICA
  USUARIO
  GLITCHTIP
}

enum QuemConcluiEtapa {
  FABRICA
  PAULO
  QUALQUER
  FLOW
}

enum EstadoDaParte {
  PLANEJANDO
  EM_CURSO
  FEITA
  PUBLICANDO
  NO_AR
  NAO_CHEGOU
  DESCARTADA
}

enum ChegadaAoAr {
  PUBLICACAO
  VERSAO
}

model ParteDaDemanda {
  id             String               @id @default(uuid())
  demandaId      String
  chave          String
  repositorioId  String
  objetivo       String?
  ordem          Int
  dependeDe      String[]
  chegaAoAr      ChegadaAoAr          @default(PUBLICACAO)
  estado         EstadoDaParte        @default(PLANEJANDO)
  planoCaminho   String?
  planoPrUrl     String?
  prs            Json                 @default("[]")
  commitAlvo     String?
  pedidoId       String?
  motivo         String?
  sobeParaVersao String?
  feitaEm        DateTime?
  naoChegouEm    DateTime?
  noArEm         DateTime?
  commitNoAr     String?
  conferidaPorId String?
  criadaEm       DateTime             @default(now())
  atualizadaEm   DateTime             @updatedAt
  demanda        Demanda              @relation(fields: [demandaId], references: [id], onDelete: Cascade)
  repositorio    RepositorioGitHub    @relation(fields: [repositorioId], references: [id], onDelete: Restrict)
  conferidaPor   Usuario?             @relation(fields: [conferidaPorId], references: [id], onDelete: SetNull)
  pedidos        PedidoDePublicacao[]
  consertos      PedidoDeConserto[]

  @@unique([demandaId, chave])
  @@index([repositorioId, estado])
}

enum TipoDeArquivoDaDemanda {
  ANEXO
  DESENHO
  CAPTURA
}

// O modelo padrão e o índice único parcial "um padrão" são criados à mão na migration.
model ModeloDeEtapas {
  id       String          @id @default(uuid())
  nome     String          @unique
  padrao   Boolean         @default(false)
  criadoEm DateTime        @default(now())
  etapas   EtapaDoModelo[]
  projetos Projeto[]
}

model EtapaDoModelo {
  id            String                  @id @default(uuid())
  modeloId      String
  ordem         Int
  chave         String
  nome          String
  rotulo        String
  marco         String?
  quemConclui   QuemConcluiEtapa
  puladaSemTela Boolean                 @default(false)
  esperaEm      NivelDeAcompanhamento[]
  modelo        ModeloDeEtapas          @relation(fields: [modeloId], references: [id], onDelete: Cascade)

  @@unique([modeloId, ordem])
  @@unique([modeloId, chave])
}

model Demanda {
  id               String                @id @default(uuid())
  projetoId        String
  repositorioId    String
  titulo           String
  descricao        String?
  tipo             TipoDeDemanda?
  destino          DestinoDaDemanda?
  nivel            NivelDeAcompanhamento
  temTela          Boolean
  origem           OrigemDaDemanda
  fonteId          String?
  chaveDaFonte     String?
  criadaPorId      String?
  modeloId         String?
  etapas           Json
  etapaAtual       String
  concluidas       String[]
  espera           String?
  esperaMotivo     String?
  esperaDesde      DateTime?
  antesDaTrava     Json?
  triagem          Json?
  recusasDoDesenho Int                   @default(0)
  falhasDoTeste    Int                   @default(0)
  versaoDoDesenho  Int                   @default(0)
  desenhoAprovado  Int?
  planoCaminho     String?
  planoPrUrl       String?
  artefatoUrl      String?
  prs              String[]
  encerrada        String?
  entregueEm       DateTime?
  naoChegouDesde   DateTime?
  noArEm           DateTime?
  criadaEm         DateTime              @default(now())
  atualizadaEm     DateTime              @updatedAt
  projeto          Projeto               @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  repositorio      RepositorioGitHub     @relation(fields: [repositorioId], references: [id], onDelete: Restrict)
  fonte            FonteDeDemandas?      @relation(fields: [fonteId], references: [id], onDelete: SetNull)
  criadaPor        Usuario?              @relation(fields: [criadaPorId], references: [id], onDelete: SetNull)
  eventos          EventoDaDemanda[]
  arquivos         ArquivoDaDemanda[]
  pedidos          PedidoDePublicacao[]
  conversas        Conversa[]
  partes           ParteDaDemanda[]
  consertos        PedidoDeConserto[]
  erros            ErroDoGlitchTip[]     @relation("ErroDaDemanda")
  relatos          Relato[]

  @@unique([fonteId, chaveDaFonte])
  @@index([encerrada, espera])
  @@index([projetoId, criadaEm])
}

model EventoDaDemanda {
  seq          BigInt   @id @default(autoincrement())
  idExterno    String   @unique
  demandaId    String
  tipo         String
  origem       String
  usuarioId    String?
  fonteId      String?
  dados        Json
  em           DateTime
  registradoEm DateTime @default(now())
  demanda      Demanda  @relation(fields: [demandaId], references: [id], onDelete: Cascade)

  @@index([demandaId, seq])
}

model ArquivoDaDemanda {
  id         String                 @id
  demandaId  String
  tipo       TipoDeArquivoDaDemanda
  nome       String
  conteudo   String
  tamanho    Int
  tela       String?
  versao     Int?
  enviadoPor String
  fonteId    String?
  usuarioId  String?
  criadoEm   DateTime               @default(now())
  apagadoEm  DateTime?
  demanda    Demanda                @relation(fields: [demandaId], references: [id], onDelete: Cascade)

  @@index([demandaId, tipo])
}

model FonteDeDemandas {
  id          String    @id @default(uuid())
  nome        String
  tokenHash   String    @unique
  criadoEm    DateTime  @default(now())
  revogadaEm  DateTime?
  criadaPorId String
  ultimoUsoEm DateTime?
  criadaPor   Usuario   @relation(fields: [criadaPorId], references: [id], onDelete: Restrict)
  demandas    Demanda[]
}

// Escritório da Fábrica: quanto cada parte (raia) e cada etapa de demanda levou, para a previsão de entrega.
// `chave` é `<planoId>:<raia>` (parte do retrato v2), `execucao:<runId>` (semente do histórico) ou
// `<demandaId>:<marco>` (etapa). O `fim` gravado nunca é apagado.
model IntervaloDaFabrica {
  id           String    @id @default(uuid())
  fonteId      String?
  repositorio  String
  chave        String    @unique
  tipo         String
  papel        String?
  etapa        String?
  inicio       DateTime
  fim          DateTime?
  custoUsd     Decimal?  @db.Decimal(12, 4)
  atualizadoEm DateTime  @updatedAt

  @@index([tipo, papel])
}

enum AutorDaMensagem {
  PAULO
  AGENTE
  FLOW
}

enum EstadoDoCartao {
  PROPOSTO
  CONFIRMANDO
  CONFIRMADO
  SUBSTITUIDO
}

// Decidir: conversa do Paulo com o atendente sobre um item (issue/PR/demanda).
model Conversa {
  id                 String            @id @default(uuid())
  chave              String            @unique
  tipo               String
  demandaId          String?
  issueUrl           String?
  repositorio        String
  titulo             String
  contexto           Json
  aguardaAgenteDesde DateTime?
  responderA         String?
  puladaEm           DateTime?
  adiadaAte          DateTime?
  guardadaEm         DateTime?
  encerradaEm        DateTime?
  encerramento       String?
  criadaEm           DateTime          @default(now())
  atualizadaEm       DateTime          @updatedAt
  demanda            Demanda?          @relation(fields: [demandaId], references: [id], onDelete: SetNull)
  mensagens          Mensagem[]
  anexos             AnexoDaMensagem[]
  cartoes            CartaoDeFecho[]

  @@index([encerradaEm, aguardaAgenteDesde])
}

model Mensagem {
  seq              BigInt          @id @default(autoincrement())
  id               String          @unique
  conversaId       String
  autor            AutorDaMensagem
  texto            String
  respostaRapida   String?
  respostasRapidas Json            @default("[]")
  emRespostaA      String?
  impressao        String
  usuarioId        String?
  criadaEm         DateTime        @default(now())
  conversa         Conversa        @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  usuario          Usuario?        @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([conversaId, seq])
}

model AnexoDaMensagem {
  id         String   @id
  conversaId String
  mensagemId String?
  nome       String
  conteudo   String
  tamanho    Int
  criadoEm   DateTime @default(now())
  conversa   Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  @@index([conversaId])
}

// No máximo um cartão PROPOSTO ou CONFIRMANDO por conversa (índice parcial na migration).
model CartaoDeFecho {
  id              String         @id @default(uuid())
  conversaId      String
  mensagemSeq     BigInt?
  origem          String
  conteudo        Json
  estado          EstadoDoCartao @default(PROPOSTO)
  progresso       Json           @default("{}")
  erro            String?
  confirmandoEm   DateTime?
  confirmadoEm    DateTime?
  confirmadoPorId String?
  criadoEm        DateTime       @default(now())
  conversa        Conversa       @relation(fields: [conversaId], references: [id], onDelete: Cascade)
  confirmadoPor   Usuario?       @relation(fields: [confirmadoPorId], references: [id], onDelete: SetNull)

  @@index([conversaId, estado])
}

// Erros do GlitchTip (D81): uma linha por issue, atualizada a cada leitura; `demandaId` é a demanda
// atual e `demandaAnteriorId` a que foi ao ar antes de o erro voltar. `serie` guarda até 6 pontos
// `{ hora, total }` para as barrinhas.
model ErroDoGlitchTip {
  id                String            @id @default(uuid())
  issueId           String            @unique
  projetoGlitchTip  String
  repositorioId     String
  titulo            String
  onde              String?
  nivel             String
  link              String
  eventos           Int
  usuarios          Int
  primeiroEm        DateTime
  ultimoEm          DateTime
  resolvidoEm       DateTime?
  demandaId         String?
  demandaAnteriorId String?
  esperaDesde       DateTime?
  grupo             String            @default("")
  serie             Json              @default("[]")
  criadoEm          DateTime          @default(now())
  atualizadoEm      DateTime          @updatedAt
  repositorio       RepositorioGitHub @relation(fields: [repositorioId], references: [id], onDelete: Cascade)
  demanda           Demanda?          @relation("ErroDaDemanda", fields: [demandaId], references: [id], onDelete: SetNull)

  @@index([projetoGlitchTip, resolvidoEm])
  @@index([projetoGlitchTip, grupo])
  @@index([demandaId])
}

model LeituraDoGlitchTip {
  projetoGlitchTip String    @id
  ligadaEm         DateTime  @default(now())
  ultimoSucessoEm  DateTime?
  ultimaFalhaEm    DateTime?
  motivo           String?
}

// ——— Busca de demandas com IA (spec 2026-11-26-demandas-busca-com-ia-design.md) ———

enum EstadoDaBusca {
  PENDENTE
  EM_CURSO
  CONCLUIDA
  FALHOU
}

model BuscaDeDemandas {
  id                  String        @id @default(uuid())
  pergunta            String
  perguntaNormalizada String
  pedidaPorId         String?
  loteIds             String[]
  /// sha256 dos ids do lote, ordenados: a mesma pergunta no mesmo lote reaproveita a resposta.
  chaveDoLote         String
  tokensDoLote        Int
  estado              EstadoDaBusca @default(PENDENTE)
  buscadaEm           DateTime?
  respostaId          String?       @unique
  impressao           String?
  resumo              String?
  itens               Json          @default("[]")
  falha               String?
  modelo              String?
  tokensEntrada       Int?
  tokensSaida         Int?
  custoUsd            Float?
  criadaEm            DateTime      @default(now())
  concluidaEm         DateTime?
  pedidaPor           Usuario?      @relation(fields: [pedidaPorId], references: [id], onDelete: SetNull)

  @@index([estado, criadaEm])
  @@index([perguntaNormalizada, chaveDoLote, criadaEm])
}

// Relatos de usuários (D83): sistemas conectados, relatos buscados e a caixa de saída do andamento.
enum EstadoDoSistema {
  ATIVO
  DESCONECTADO
  REVOGADO
}

enum ResultadoDoRelato {
  SEGUE
  ORIENTADO
}

enum CanalDoRelato {
  SISTEMA
  WHATSAPP
}

enum SituacaoDoEnvio {
  PENDENTE
  ENVIADO
  DESCARTADO
}

model SistemaConectado {
  id                String            @id @default(uuid())
  nome              String
  /// Base com o prefixo da API (ex.: https://sistema.exemplo.com/v1), sem barra no fim.
  url               String
  projetoId         String
  repositorioId     String
  /// v1.<iv>.<tag>.<cifrado>, AAD `sistema:<id>`; null depois de revogar. Nunca volta à tela.
  tokenCifrado      String?
  cursor            String?
  estado            EstadoDoSistema   @default(ATIVO)
  /// Também é a trava da busca: só uma busca por sistema a cada intervalo.
  ultimaTentativaEm DateTime?
  ultimaBuscaOkEm   DateTime?
  ultimoErro        String?
  criadoEm          DateTime          @default(now())
  atualizadoEm      DateTime          @updatedAt
  revogadoEm        DateTime?
  projeto           Projeto           @relation(fields: [projetoId], references: [id], onDelete: Restrict)
  repositorio       RepositorioGitHub @relation(fields: [repositorioId], references: [id], onDelete: Restrict)
  relatos           Relato[]

  @@index([estado, ultimaTentativaEm])
}

model Relato {
  id             String             @id @default(uuid())
  sistemaId      String
  idExterno      String
  ticket         String?
  resultado      ResultadoDoRelato
  canal          CanalDoRelato
  em             DateTime
  autorIdExterno String
  autorNome      String
  autorPapel     String
  /// null nos orientados (só o assunto fica).
  texto          String?
  transcricao    String?
  tipoSugerido   String?
  assunto        String?
  versao         String?
  demandaId      String?
  /// {tipo, caminho, bytes}[]: o download fica para o passo seguinte.
  anexos         Json               @default("[]")
  sinais         Json               @default("[]")
  criadoEm       DateTime           @default(now())
  atualizadoEm   DateTime           @updatedAt
  sistema        SistemaConectado   @relation(fields: [sistemaId], references: [id], onDelete: Restrict)
  demanda        Demanda?           @relation(fields: [demandaId], references: [id], onDelete: SetNull)
  envios         EnvioDeAndamento[]

  @@unique([sistemaId, idExterno])
  @@index([demandaId])
  @@index([resultado, em])
}

model EnvioDeAndamento {
  id                 String          @id @default(uuid())
  relatoId           String
  estado             String
  mensagem           String
  /// 'automatico' | 'paulo'
  origem             String
  situacao           SituacaoDoEnvio @default(PENDENTE)
  tentativas         Int             @default(0)
  proximaTentativaEm DateTime        @default(now())
  ultimoErro         String?
  criadoEm           DateTime        @default(now())
  enviadoEm          DateTime?
  relato             Relato          @relation(fields: [relatoId], references: [id], onDelete: Cascade)

  @@unique([relatoId, estado])
  @@index([situacao, proximaTentativaEm])
}
