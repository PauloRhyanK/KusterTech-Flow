# Amostra de desempenho da oficina. Relatório: python3 -I /opt/oficina/metricas_oficina.py relatorio
[Unit]
Description=Amostra de desempenho da oficina (RAM, swap, PSI, OOM, CPU, raias e jobs de CI) e retrato dos contêineres

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /opt/oficina/metricas_oficina.py coletar
ExecStart=/usr/bin/python3 -I /opt/oficina/metricas_oficina.py retrato
Nice=5
